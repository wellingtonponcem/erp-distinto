Options -Indexes
Options -MultiViews
RewriteEngine On

RewriteBase /

# Se o arquivo ou pasta existe fisicamente, serve direto
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Garante que /sistema/sistema nao seja afetado
RewriteRule ^sistema(/.*)?$ - [L]

# Rotas limpas do site
RewriteRule ^projetos/?$       projetos/index.php [L,QSA]
RewriteRule ^sobre/?$          sobre/index.php    [L,QSA]
RewriteRule ^contato/?$        contato/index.php  [L,QSA]
RewriteRule ^admin/?$          admin/index.php    [L,QSA]
RewriteRule ^setup/?$          setup/install.php  [L,QSA]

# Seguranca: bloqueia acesso direto a includes/
RewriteRule ^includes/         -                  [F,L]

# PHP configs
php_value upload_max_filesize 64M
php_value post_max_size 64M
php_value memory_limit 256M
php_value max_execution_time 60

# Cache para assets estaticos
<FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
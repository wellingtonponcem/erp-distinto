Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /sistema/sistema/

    # Proteger arquivos e pastas sensiveis
    RewriteRule ^(config|includes)/ - [F,L]
    <FilesMatch "^(env|database|auth)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Rota para propostas: /p/slug-da-proposta
    RewriteRule ^p/([a-zA-Z0-9_-]+)/?$ p.php?slug=$1 [QSA,L]

    # Se for um arquivo ou diretorio real, serve direto
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Roteamento padrao (opcional, caso queira URLs limpas no futuro)
    # RewriteRule ^ index.php [L]
</IfModule>

# PHP charset
AddDefaultCharset UTF-8

# Headers de seguranca
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>